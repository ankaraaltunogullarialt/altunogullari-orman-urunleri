<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.webServer>
        <handlers>
            <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
        </handlers>
        <httpPlatform 
            processPath="C:\Users\Eymen\Desktop\OrmanFabrikam\venv\Scripts\python.exe"
            arguments="-m waitress --listen=127.0.0.1:%HTTP_PLATFORM_PORT% fabrika.wsgi:application"
            stdoutLogEnabled="true"
            stdoutLogFile="C:\Users\Eymen\Desktop\OrmanFabrikam\logs\stdout.log"
            startupTimeLimit="120"
            processStartupRetryCount="3"
            stdoutLogEnabled="true"
            startupRetryInterval="10">
            <environmentVariables>
                <environmentVariable name="DJANGO_SETTINGS_MODULE" value="fabrika.settings" />
                <environmentVariable name="PYTHONPATH" value="C:\Users\Eymen\Desktop\OrmanFabrikam" />
            </environmentVariables>
        </httpPlatform>
    </system.webServer>
</configuration>